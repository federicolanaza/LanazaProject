rules_version = '2';

/**
 * LibTrack Analytics - Firestore Security Rules
 * 
 * Core Philosophy:
 * This ruleset implements a robust, DBAC (Database-Backed Access Control) model combined with 
 * strict ownership validation. Administrative privileges are decoupled from the user's 
 * profile document and are instead verified via a dedicated '/roles_admin' collection 
 * to ensure atomic, independent authorization checks.
 * 
 * Data Structure:
 * - /users/{userId}: User profiles, owned by the individual and accessible by admins.
 * - /roles_admin/{adminId}: Flag documents; existence of a UID here grants administrative access.
 * - /visitor_check_ins/{checkInId}: Denormalized check-in records.
 * - /user_sessions/{sessionId}: Real-time session tracking for the admin dashboard.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Global Helper Functions ---

    /** Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the authenticated user has administrative privileges. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /** Checks if the provided ID matches the authenticated user's UID. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Checks if the data field (e.g., userId) matches the authenticated user's UID. */
    function isDocumentOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    /** Combines ownership check with existence check for updates and deletes. */
    function isExistingOwner(ownerId) {
      return resource != null && isDocumentOwner(ownerId);
    }

    // --- Collection Rules ---

    /**
     * @description Rules for user profiles. Users manage their own; admins manage all.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if (isOwner(userId) || isAdmin()) && resource != null && request.resource.data.id == resource.data.id;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Administrative flag collection. 
     * For this prototype, we allow a user to create their own admin entry to support 
     * the "designated admin" bootstrap logic in the login page.
     */
    match /roles_admin/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(adminId); 
      allow update, delete: if isAdmin();
    }

    /**
     * @description Tracks individual visitor check-ins.
     */
    match /visitor_check_ins/{checkInId} {
      allow get: if isSignedIn() && (isDocumentOwner(resource.data.userId) || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || request.query.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Real-time user sessions for admin monitoring.
     */
    match /user_sessions/{sessionId} {
      allow get: if isSignedIn() && (isDocumentOwner(resource.data.userId) || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || request.query.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if resource != null && (isExistingOwner(resource.data.userId) || isAdmin()) && request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin() && resource != null;
    }

  }
}